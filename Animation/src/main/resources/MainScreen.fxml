<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Text?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="600.0" prefWidth="600.0" stylesheets="@MainScreen.css"
            xmlns="http://javafx.com/javafx/21" fx:controller="graphics.animation.MainScreenController">
    <VBox layoutX="14.0" layoutY="53.0" prefHeight="600.0" prefWidth="200.0" styleClass="left-panel"
          AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
        <Text id="main-heading" strokeType="OUTSIDE" strokeWidth="0.0" text="Animation"/>
        <Line id="margin" endX="160.0"/>
        <Button mnemonicParsing="false" onAction="#showBallRolling" text="Ball Rolling"/>
        <Button mnemonicParsing="false" onAction="#showBallColliding" text="Ball Colliding"/>
        <Button mnemonicParsing="false" onAction="#showBallBouncing" text="Ball Bouncing"/>
        <Button mnemonicParsing="false" onAction="#showBallDragging" text="Ball Dragging"/>
        <Button mnemonicParsing="false" onAction="#showBallZoomingX" text="Ball Zoom X"/>
        <Button layoutX="30.0" layoutY="261.0" mnemonicParsing="false" onAction="#showBallZoomingY" text="Ball Zoom Y"/>
        <Button layoutX="30.0" layoutY="304.0" mnemonicParsing="false" onAction="#showBallZooming" text="Ball Zooming"/>
        <Button layoutX="30.0" layoutY="388.0" mnemonicParsing="false" onAction="#showDaySky" text="Day SKy"/>
        <Button layoutX="30.0" layoutY="346.0" mnemonicParsing="false" onAction="#showNightSky" text="Night Sky"/>
        <Button mnemonicParsing="false" onAction="#showBucketFilling" text="Bucket Filling"/>
        <CheckBox fx:id="dayNightCheckbox" mnemonicParsing="false" selected="true" text="Day"/>
        <HBox prefHeight="100.0" spacing="5.0">
            <Button mnemonicParsing="false" onAction="#playAnimation" text="play"/>
            <Button mnemonicParsing="false" onAction="#pauseAnimation" text="pause"/>
            <Button mnemonicParsing="false" onAction="#stopAnimation" text="stop"/>
        </HBox>
    </VBox>
    <StackPane layoutX="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <Pane fx:id="backgroundPane" prefHeight="200.0" prefWidth="200.0">
            <ImageView fx:id="upperImageView" fitHeight="300.0" fitWidth="400.0" pickOnBounds="true"
                       preserveRatio="true"/>
        </Pane>
        <Pane fx:id="mainPane" prefHeight="600.0" prefWidth="400.0"/>
    </StackPane>
</AnchorPane>
